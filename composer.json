{
	"name": "mediadreams/md-notifications",
	"description": "Notify frontend users about the creation of new data records. Every data type can be configured easily, for example pages (blog posts) or tx_news records.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"extension",
		"notifications"
	],
	"authors": [
		{
			"name": "Christoph Daecke",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/cdaecke/md_notifications/issues",
		"source": "https://github.com/cdaecke/md_notifications"
	},
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"doctrine/dbal": "^4.4.3",
		"psr/http-message": "^1.1 || ^2.0",
		"symfony/console": "^7.4",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-extbase": "^13.4 || ^14.3",
		"typo3/cms-fluid": "^13.4 || ^14.3",
		"typo3/cms-frontend": "^13.4 || ^14.3",
		"typo3/cms-scheduler": "^13.4 || ^14.3"
	},
	"autoload": {
		"psr-4": {
			"Mediadreams\\MdNotifications\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "md_notifications"
		}
	}
}
